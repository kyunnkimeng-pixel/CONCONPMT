{
  "name": "pmtconcon-studio",
  "private": true,
  "version": "0.1.1",
  "description": "PMTCONCON Studio desktop app scaffold",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite",
    "build": "tsc && vite build",
    "web:build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "license:forbidden": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-forbidden-dependencies.ps1",
    "license:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-licenses.ps1",
    "license:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-third-party-licenses.ps1",
    "release:checksums": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-release-checksums.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "^1.169.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.5"
  }
}
