{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMTCONCON Studio",
  "version": "0.1.2",
  "identifier": "com.pmtconcon.studio",
  "build": {
    "beforeDevCommand": "npm.cmd run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PMTCONCON Studio",
        "width": 1200,
        "height": 760,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
